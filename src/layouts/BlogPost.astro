  <meta name="viewport" content="width=device-width" />
  <title>{frontmatter.title}</title>

  <link rel="stylesheet" href="/css/style.css" />
</head>

<body>

  <header>
    <a href="/Katsura_memo/">← かつらのメモ</a>
  </header>

  <main>
    <p>
    {frontmatter.Date}
    </p>
    
    <h1>{frontmatter.title}</h1>
